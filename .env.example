# Copy to .env and fill in. `cp .env.example .env`
ENV=dev

# ---- auth ----
# Regenerate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=60

# ---- storage ----
DATABASE_URL=sqlite:///./data/app.db
REDIS_URL=redis://localhost:6379/0

# ---- http ----
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:8000

# ---- retrieval ----
# MUST match the model the FAISS index was built with (see data/cache/index_meta.json).
# Pointing this at the base model while the index was built from the fine-tuned
# one silently returns garbage; startup now refuses to run on a mismatch.
EMBEDDING_MODEL=models/biomed-miniLM
INDEX_PATH=data/cache/faiss.index
EMB_PATH=data/cache/embeddings.npy
CORPUS_JSONL_PATH=data/cache/corpus.jsonl
TOP_K=10

HYBRID_ENABLED=true
HYBRID_ALPHA=0.5
RERANK_ENABLED=false

# ---- rate limiting ----
RATE_LIMIT_TIMES=30
RATE_LIMIT_SECONDS=60
